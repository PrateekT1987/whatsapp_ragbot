# ---------------------------------------------------------------- WAHA
# This file is for the WORK WhatsApp session
WAHA_BASE_URL=http://localhost:3002
WAHA_SESSION=work
WAHA_API_KEY=
WAHA_HMAC_KEY=
WAHA_SELF_CHAT_ONLY=true
WAHA_SEND_RETRIES=2
WAHA_TIMEOUT=30
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# ----------------------------------------------------------------- LLM
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=
# Enable streaming: send tokens to WhatsApp as they arrive
LLM_STREAMING=false
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=2.0
LLM_TIMEOUT=120
SHOW_SOURCES=true

# ---------------------------------------------------------- Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
MULTILINGUAL_MODEL=intfloat/multilingual-e5-small

# ---------------------------------------------------------- Vector Store (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents_work

# ---------------------------------------------------------- Structured Data (SQLite)
ENABLE_TABLE_EXTRACTION=true
STRUCTURED_DB_PATH=./cache/work/structured_data.sqlite

# ---------------------------------------------------------- Caching
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_DIR=./cache/work
EXACT_CACHE_SIZE=1000
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_MAX_ENTRIES=500

# ------------------------------------------------------------- Server
PORT=8000
HOST=0.0.0.0
UVICORN_RELOAD=false

# ---------------------------------------------------------- Concurrency
MAX_CONCURRENT_QUERIES=2
MAX_QUEUED_PER_CHAT=5
STREAM_CHUNK_DELAY_MS=400
STARTUP_RETRY_SECONDS=2

# ------------------------------------------------------ Conversation
CONVERSATION_MEMORY_SIZE=3
CONVERSATION_TTL=3600

# ---------------------------------------------------- Feedback
FEEDBACK_ENABLED=true
FEEDBACK_DB_PATH=./cache/work/feedback.sqlite

# -------------------------------------------------- Voice Notes
WHISPER_ENABLED=true
WHISPER_MODEL=tiny
WHISPER_LANGUAGE=

# ---------------------------------------------------------- Logging
LOG_LEVEL=INFO
LOG_QUESTION_TEXT=false

# ----------------------------------------------------------------- RAG
DOCUMENTS_PATH=./documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4

SYSTEM_PROMPT=You are a helpful assistant that answers questions based on the provided documents. If the answer is not in the documents, say you don't know.