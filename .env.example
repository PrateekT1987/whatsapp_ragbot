# Twilio Configuration
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886  # Twilio sandbox number or your approved number

# LLM Provider Configuration (choose one: openai or openrouter)
LLM_PROVIDER=openai  # or "openrouter"
OPENAI_API_KEY=your_openai_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here  # Get from https://openrouter.ai/keys
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=gpt-4o-mini  # Model to use (e.g., gpt-4o-mini, claude-3-haiku, etc.)

# Application Configuration
WEBHOOK_URL=https://your-domain.com/webhook  # Public URL for Twilio webhook
PORT=8000
HOST=0.0.0.0

# RAG Configuration
DOCUMENTS_PATH=./documents
CHROMA_PERSIST_DIR=./chroma_db
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4

# Optional: Custom system prompt
SYSTEM_PROMPT=You are a helpful assistant that answers questions based on the provided documents. If the answer is not in the documents, say you don't know.