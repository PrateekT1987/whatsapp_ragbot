# ---------------------------------------------------------------- WAHA
# From your host machine WAHA is on localhost. Inside docker-compose the bot
# service overrides this with http://waha:3000.
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
# Optional: require this key on every WAHA API call.
# Generate one with: openssl rand -hex 24
# If you leave it empty WAHA generates a random key on every start and the bot
# cannot authenticate; to disable auth instead set WAHA_NO_API_KEY=true in the
# waha service of docker-compose.yml (only for localhost-only setups).
WAHA_API_KEY=
# Optional: verify the X-Hmac-Signature header on incoming webhooks.
WAHA_HMAC_KEY=
# Only answer in the "Message Yourself" chat (recommended).
WAHA_SELF_CHAT_ONLY=true
# Dashboard login at http://localhost:3000/dashboard
# WAHA ignores common passwords ("waha", "admin", "123", ...) and generates a
# random one; set a strong value here.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# ----------------------------------------------------------------- LLM
# openrouter (default) or openai
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Enable streaming: send tokens to WhatsApp as they arrive (requires OpenRouter/OpenAI streaming support)
LLM_STREAMING=false

# ---------------------------------------------------------- Embeddings
# local (bundled ONNX MiniLM, free, no API key) or openai
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------- Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents

# ---------------------------------------------------------- Caching
# Enable semantic cache for query responses
CACHE_ENABLED=true
# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600
# Cache directory (diskcache)
CACHE_DIR=./cache
# Exact-match cache for frequent questions (in-memory, very fast)
EXACT_CACHE_SIZE=1000

# ------------------------------------------------------------- Server
WEBHOOK_URL=http://localhost:8000/webhook
PORT=8000
HOST=0.0.0.0

# ----------------------------------------------------------------- RAG
DOCUMENTS_PATH=./documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4

SYSTEM_PROMPT=You are a helpful assistant that answers questions based on the provided documents. If the answer is not in the documents, say you don't know.