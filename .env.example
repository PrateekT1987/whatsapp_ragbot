# ================================================== Docker Compose (multi-session)
# These are read by docker-compose.yml, not by the bot itself. Each session has
# its own WAHA container, so each needs its own key/password.
# Generate keys with: openssl rand -hex 24
WAHA_API_KEY_PERSONAL=
WAHA_HMAC_KEY_PERSONAL=
WAHA_DASHBOARD_USERNAME_PERSONAL=admin
WAHA_DASHBOARD_PASSWORD_PERSONAL=

WAHA_API_KEY_WORK=
WAHA_HMAC_KEY_WORK=
WAHA_DASHBOARD_USERNAME_WORK=admin
WAHA_DASHBOARD_PASSWORD_WORK=

# Qdrant API key (required). Injected into the qdrant service and both bots.
QDRANT_API_KEY=

# ================================================== Bot defaults (single-session)
# For the multi-session setup these live in .env.personal / .env.work instead.
# From your host machine WAHA is on localhost. Inside docker-compose the bot
# service overrides this with the WAHA container name.
WAHA_BASE_URL=http://localhost:3000
WAHA_SESSION=default
# Optional: require this key on every WAHA API call.
# Generate one with: openssl rand -hex 24
# If you leave it empty WAHA generates a random key on every start and the bot
# cannot authenticate; to disable auth instead set WAHA_NO_API_KEY=true in the
# waha service of docker-compose.yml (only for localhost-only setups).
WAHA_API_KEY=
# Optional: verify the X-Webhook-Hmac header on incoming webhooks.
WAHA_HMAC_KEY=
# Only answer in the "Message Yourself" chat (recommended).
WAHA_SELF_CHAT_ONLY=true
# Bounded retries for transient WAHA failures (429/5xx/connection).
WAHA_SEND_RETRIES=2
WAHA_TIMEOUT=30
# Dashboard login at http://localhost:3000/dashboard
# WAHA ignores common passwords ("waha", "admin", "123", ...) and generates a
# random one; set a strong value here.
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# ----------------------------------------------------------------- LLM
# openrouter (default) or openai
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Optional second :free model used when the primary stays rate-limited.
LLM_FALLBACK_MODEL=
# Enable streaming: send tokens to WhatsApp as they arrive (requires OpenRouter/OpenAI streaming support)
LLM_STREAMING=false
# Retries for transient LLM failures (429, 5xx, timeouts) and their base delay.
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=2.0
LLM_TIMEOUT=120
# Append "Source: file, page N" to answers.
SHOW_SOURCES=true

# ---------------------------------------------------------- Embeddings
# local (bundled ONNX MiniLM, free, no API key) or openai or multilingual
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
# Multilingual model (intfloat/multilingual-e5-small, 384-dim, supports 100+ languages)
MULTILINGUAL_MODEL=intfloat/multilingual-e5-small

# ---------------------------------------------------------- Vector Store (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents

# ---------------------------------------------------------- Structured Data (SQLite)
# Enable table extraction from PDFs (parses rows into SQLite for exact queries)
ENABLE_TABLE_EXTRACTION=true
# SQLite database path
STRUCTURED_DB_PATH=./cache/structured_data.sqlite

# ---------------------------------------------------------- Caching
# Enable semantic cache for query responses
CACHE_ENABLED=true
# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600
# Cache directory (diskcache)
CACHE_DIR=./cache
# Exact-match cache for frequent questions (in-memory, very fast)
EXACT_CACHE_SIZE=1000
# Semantic cache: embedding-based paraphrase matching (experimental)
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.85
SEMANTIC_CACHE_MAX_ENTRIES=500

# ------------------------------------------------------------- Server
PORT=8000
HOST=0.0.0.0
# Development only: auto-restart on .py edits. Keep false in Docker/production.
# `RELOAD` is accepted as an alias for older deployments.
UVICORN_RELOAD=false

# ---------------------------------------------------------- Concurrency
# At most this many LLM calls run at once across all chats.
MAX_CONCURRENT_QUERIES=2
# Messages waiting per chat (keeps replies ordered, memory bounded).
MAX_QUEUED_PER_CHAT=5
# Delay between streamed bubbles (WhatsApp flood protection), milliseconds.
STREAM_CHUNK_DELAY_MS=400
# First retry delay when Qdrant is unavailable at startup (doubles to 60s).
STARTUP_RETRY_SECONDS=2

# ------------------------------------------------------ Conversation
# Number of previous Q&A pairs to keep per chat for context
CONVERSATION_MEMORY_SIZE=3
# Max age of conversation history in seconds
CONVERSATION_TTL=3600

# ---------------------------------------------------- Feedback
# Enable /good /bad feedback commands
FEEDBACK_ENABLED=true
# Path to store feedback
FEEDBACK_DB_PATH=./cache/feedback.sqlite

# -------------------------------------------------- Voice Notes
# Transcribe WhatsApp voice messages locally (faster-whisper, CPU).
WHISPER_ENABLED=true
# tiny is prefetched into the image; base/small/medium/large download on first use.
WHISPER_MODEL=tiny  # tiny, base, small, medium, large
WHISPER_LANGUAGE=  # empty = auto-detect

# ---------------------------------------------------------- Logging
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
# Question text is private by default: log only its length at INFO.
LOG_QUESTION_TEXT=false

# ----------------------------------------------------------------- RAG
DOCUMENTS_PATH=./documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4

SYSTEM_PROMPT=You are a helpful assistant that answers questions based on the provided documents. If the answer is not in the documents, say you don't know.