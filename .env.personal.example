# ---------------------------------------------------------------- WAHA
# This file is for the PERSONAL WhatsApp session
WAHA_BASE_URL=http://localhost:3001
WAHA_SESSION=personal
WAHA_API_KEY=
WAHA_HMAC_KEY=
WAHA_SELF_CHAT_ONLY=true
WAHA_SEND_RETRIES=2
WAHA_TIMEOUT=30
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=

# ----------------------------------------------------------------- LLM
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODEL=
OPENAI_API_KEY=
# Enable streaming: send tokens to WhatsApp as they arrive
LLM_STREAMING=false
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_SECONDS=2.0
LLM_TIMEOUT=120
SHOW_SOURCES=true

# ---------------------------------------------------------- Embeddings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------- Vector Store (Qdrant)
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_documents_personal

# ---------------------------------------------------------- Caching
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_DIR=./cache/personal
EXACT_CACHE_SIZE=1000

# ------------------------------------------------------------- Server
PORT=8000
HOST=0.0.0.0
UVICORN_RELOAD=false

# ---------------------------------------------------------- Concurrency
MAX_CONCURRENT_QUERIES=2
MAX_QUEUED_PER_CHAT=5
STREAM_CHUNK_DELAY_MS=400
STARTUP_RETRY_SECONDS=2

# ---------------------------------------------------------- Logging
LOG_LEVEL=INFO
LOG_QUESTION_TEXT=false

# ----------------------------------------------------------------- RAG
DOCUMENTS_PATH=./documents
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=4

SYSTEM_PROMPT=You are a helpful assistant that answers questions based on the provided documents. If the answer is not in the documents, say you don't know.